<Window x:Class="AP_Coursework_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AP_Coursework_GUI"
        mc:Ignorable="d"
        Title="Expression Interpreter"
        Height="700" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowState="Maximized"
        Background="{StaticResource SurfaceAltBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Menu Grid.Row="0">
            <MenuItem Header="_Help" Click="HelpMenu_Click"/>
        </Menu>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,10">
            <Border.Effect>
                <DropShadowEffect Color="#33000000" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel Orientation="Vertical" VerticalAlignment="Top" >
                <TextBlock Text="Enter expression or definitions:"  FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBox Name="InputTextBox" Height="90" FontSize="14" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Examples: y(x)=sin(x) for plotting/analysis, or define functions like f(x)=x^2; y(x) is optional for transpiling."/>
                <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center" ItemHeight="32" ItemWidth="Auto">
                    <Button Content="Evaluate" Width="110" Click="Evaluate_Click"/>

                    <TextBlock Text="Xmin:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Name="XMinBox" Width="80" Text="-10" ToolTip="Minimum x for plotting"/>

                    <TextBlock Text="Xmax:" VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <TextBox Name="XMaxBox" Width="80" Text="10" ToolTip="Maximum x for plotting"/>

                    <TextBlock Text="Step:" VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <TextBox Name="StepBox" Width="70" Text="0.5" ToolTip="Step size for plotting"/>

                    <Button Content="Plot" Width="90" Click="Plot_Click"/>

                    <Button Content="Reset Plots" Width="120" Margin="8,0,0,0" Click="ResetPlots_Click"/>

                    <CheckBox Name="LivePlotCheck" Content="Live Plot" IsChecked="True" Margin="8,0,0,0" VerticalAlignment="Center" Checked="LivePlotCheck_Changed" Unchecked="LivePlotCheck_Changed" ToolTip="Continuously re-sample while panning/zooming"/>
                </WrapPanel>

                <TextBlock Text="Result" FontWeight="Bold" Margin="0,12,0,4"/>
                <TextBox Name="ResultTextBox" Height="36" IsReadOnly="True" FontSize="14"/>

                <TextBlock Text="Errors" FontWeight="Bold" Margin="0,12,0,4"/>
                <TextBox Name="ErrorBox" Height="30" FontSize="13" IsReadOnly="True" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Transpiler Panel -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect Color="#33000000" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            
            <Expander IsExpanded="False">
                <Expander.Header>
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="Transpiler (Interpreter → C#)"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Expander.Header>
                
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Interpreter Source" FontWeight="SemiBold"/>
                            <TextBox Name="SourceTextBox"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     Height="160"
                                     TextWrapping="NoWrap"/>
                        </StackPanel>

                        <GridSplitter Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="#22000000"
                                      Width="5"/>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Generated C# (read-only)" FontWeight="SemiBold"/>
                            <TextBox Name="TargetTextBox"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     Height="160"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap"/>
                        </StackPanel>
                    </Grid>

                    <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                        <Button Content="Validate Source" Margin="0,0,8,0" Click="ValidateSource_Click"/>
                        <Button Content="Transpile" Width="60" Margin="0,0,8,0" Click="Transpile_Click"/>
                        <Button Content="Validate C#" Width="70" Margin="0,0,8,0" Click="ValidateCSharp_Click"/>
                        <Button Content="Compile" Width="70" Margin="0,0,8,0" Click="Compile_Click"/>
                        <TextBlock Text="Run x:" VerticalAlignment="Center"/>
                        <TextBox Name="RunArgBox" Width="100" Text="1.0" Margin="4,0,8,0"/>
                        <Button Content="Run" Width="50" Click="RunExe_Click"/>
                    </WrapPanel>
                </Grid>
            </Expander>
        </Border>


        <Border Grid.Row="3" Style="{StaticResource Card}">
            <Border.Effect>
                <DropShadowEffect Color="#33000000" BlurRadius="12" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Plot" FontWeight="Bold" Margin="0,0,0,8"/>
                <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                    <Canvas Name="PlotCanvas"
                            Background="Transparent"
                            ClipToBounds="True"
                            MouseWheel="PlotCanvas_MouseWheel"
                            MouseLeftButtonDown="PlotCanvas_MouseLeftButtonDown"
                            MouseLeftButtonUp="PlotCanvas_MouseLeftButtonUp"
                            MouseMove="PlotCanvas_MouseMove"
                            MouseRightButtonDown="PlotCanvas_MouseRightButtonDown"
                            SizeChanged="PlotCanvas_SizeChanged"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>